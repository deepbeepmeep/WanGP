{"builds":[{"commit":"72d507536e49e624208efd04c565632ac581dea3","date":"2026-11-25T00:49:36+01:00","message":"optimisations","version":"20.20"},{"commit":"538e06f4571565d5db1a8d79bca0b4a8d2ca3970","date":"2026-11-25T00:42:34+01:00","message":"optimisations","version":"20.20"},{"commit":"5abf79e5244dc11afbd5dd9e3fb3840ef8a8e962","date":"2026-11-24T17:59:14+01:00","message":"Install the GGUF HIP kernels on RDNA3 GPUs\n\nThe gguf-v1.0.30 HIP wheels now include gfx1100-gfx1103. The installer\nroutes the GGUF ROCm wheel to RDNA3 and RDNA4 targets; the WGPKernels\nROCm wheel stays RDNA4-only. Installation docs updated.","version":"20.12"},{"commit":"de32e90c5e37f263cc73d5c55beb281fad0e4eed","date":"2026-11-24T11:57:46+01:00","message":"Fix video gallery needing two clicks to change the selection\n\nThe stale-gallery check compared thumbnail URLs with the view's file names.\nGradio's cache copy strips characters such as brackets from file names and\nfast video previews are served under another name, so an up-to-date gallery\nwas taken for a stale one: the first click re-rendered it and the selection\nwent back to the previous item. Thumbnails now carry the listed file's own\nname (orig_name) and the check compares that.","version":"20.12"},{"commit":"6a10537cf883ea4231cb56e34f59dddda0dde444","date":"2026-11-24T00:09:15+01:00","message":"fixes","version":"20.12"},{"commit":"946c1a0515a0578adbe867c7e8e8efc714adb04f","date":"2026-11-23T02:47:00+01:00","message":"Fix lmgp graph capture for LMs without an output stage (YuE2 AttributeError)","version":"20.11"},{"commit":"fac185dd9b038ee329d862fd4a0417d96718fc23","date":"2026-11-22T23:51:28+01:00","message":"fixes and improvements","version":"20.11"},{"commit":"994642c87b02ef0abbdc1bc73dd14f6b5e4497e8","date":"2026-11-22T21:30:50+01:00","message":"v20.10","version":"20.10"},{"commit":"ba5a363c8cdc4a89318a0dc77969b3a9e6fa5594","date":"2026-11-22T01:50:06+01:00","message":"extreme v1","version":"20.00"},{"commit":"3fe2546105806bd08