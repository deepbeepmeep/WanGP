            "cu128": {
                "label": "Torch 2.7.1 + CUDA 12.8 (GTX 10XX only: CUDA 13 no longer supports them)",
                "cmd": "torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1 --index-url https://download.pytorch.org/whl/cu128"
            },
            "cu130": {
                "label": "Torch 2.10.0 + CUDA 13.0 (Recommended for RTX 20XX and newer)",
                "cmd": "torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 --index-url https://download.pytorch.org/whl/cu130"                
            },
            "rocm10": {
                "label": "Torch 2.13.0 + ROCm 10.0 (TheRock, AMD)",
                "cmd": {
                    "win": "\"torch[{device}]==2.13.0+rocm10.0.0\" \"torchvision[{device}]==0.28.0+rocm10.0.0\" torchaudio==2.11.0.2+rocm10.0.0 --index-url https://stable.repo.amd.com/rocm/whl-next/",
                    "linux": "\"torch[{device}]==2.13.0+rocm10.0.0\" \"torchvision[{device}]==0.28.0+rocm10.0.0\" torchaudio==2.11.0.2+rocm10.0.0 --index-url https://stable.repo.amd.com/rocm/whl-next/"
                }
            },
            "mps": {
                "label": "Torch (MPS / Apple Silicon)",
                "cmd": "torch torchvision torchaudio"
            }
        },
